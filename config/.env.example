# Monica AI System - Environment Variables Configuration
# Copy this file to .env and add your API keys (all optional!)

# ============================================
# IMAGE SEARCH (Optional)
# ============================================
# Get free API key from: https://www.pexels.com/api/
# Free tier: 200 requests/hour
# Fallback: Uses Lorem Picsum placeholder images
PEXELS_API_KEY=your_pexels_api_key_here

# ============================================
# VIDEO SEARCH (Optional)
# ============================================
# Get free API key from: https://console.cloud.google.com/
# Free tier: 10,000 quota units/day (~100 searches)
# Setup: Create project > Enable YouTube Data API v3 > Create API key
# Fallback: Provides manual YouTube search links
YOUTUBE_API_KEY=your_youtube_api_key_here

# ============================================
# SMS ALERTS (Optional)
# ============================================
# Get free trial from: https://www.twilio.com/try-twilio
# Free tier: Trial credits for testing
# Fallback: Uses free Textbelt service
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# ============================================
# OLLAMA (Local LLM - 100% Free!)
# ============================================
# Download from: https://ollama.com
# Run: ollama pull llama3.2
# No API key needed - runs completely locally!

# ============================================
# NOTES
# ============================================
# - All API keys are OPTIONAL
# - Monica works perfectly without any configuration
# - API keys enhance functionality but use free fallbacks
# - DO NOT commit .env file to version control!
# - Add .env to your .gitignore file
