<Application x:Class="MonicaWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Monica AI Dark Theme -->
        <Color x:Key="MonicaBg">#FF0A0A1A</Color>
        <Color x:Key="MonicaPanel">#FF1A1A2E</Color>
        <Color x:Key="MonicaAccent">#FF00D4FF</Color>
        <Color x:Key="MonicaGreen">#FF00FF88</Color>
        <Color x:Key="MonicaRed">#FFFF4444</Color>
        <Color x:Key="MonicaText">#FFE0E0E0</Color>
        <Color x:Key="MonicaDimText">#FF888888</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource MonicaBg}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource MonicaPanel}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource MonicaAccent}"/>
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource MonicaGreen}"/>
        <SolidColorBrush x:Key="RedBrush" Color="{StaticResource MonicaRed}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource MonicaText}"/>
        <SolidColorBrush x:Key="DimTextBrush" Color="{StaticResource MonicaDimText}"/>

        <!-- Button style -->
        <Style x:Key="MonicaButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF16213E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF1A1A4E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
