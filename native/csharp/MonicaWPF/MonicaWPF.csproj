<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MonicaWPF</RootNamespace>
    <AssemblyName>MonicaWPF</AssemblyName>
    <ApplicationIcon>..\..\..\..\monica.ico</ApplicationIcon>
    <Title>Monica AI</Title>
    <Description>GPU-accelerated WPF frontend for Monica AI</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Pipes" Version="4.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

</Project>
