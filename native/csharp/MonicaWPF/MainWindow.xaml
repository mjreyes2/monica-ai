<Window x:Class="MonicaWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monica AI" Height="720" Width="1280"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>   <!-- Title bar -->
            <RowDefinition Height="30"/>   <!-- Status bar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" 
                BorderBrush="#FF333333" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="MONICA AI" Foreground="{StaticResource AccentBrush}"
                           FontSize="16" FontWeight="Bold" FontFamily="Segoe UI"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock Text="WPF Frontend v1.0" Foreground="{StaticResource DimTextBrush}"
                           FontSize="10" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="#FF111122" 
                BorderBrush="#FF333333" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <TextBlock x:Name="StatusSTT" Text="STT: --" Foreground="{StaticResource DimTextBrush}" 
                           FontSize="10" Margin="0,0,16,0"/>
                <TextBlock x:Name="StatusTTS" Text="TTS: --" Foreground="{StaticResource DimTextBrush}" 
                           FontSize="10" Margin="0,0,16,0"/>
                <TextBlock x:Name="StatusAI" Text="AI: --" Foreground="{StaticResource DimTextBrush}" 
                           FontSize="10" Margin="0,0,16,0"/>
                <TextBlock x:Name="StatusVision" Text="Vision: --" Foreground="{StaticResource DimTextBrush}" 
                           FontSize="10" Margin="0,0,16,0"/>
                <Separator Style="{x:Null}" Width="1" Background="#FF444444" Margin="0,4"/>
                <TextBlock x:Name="StatusEmotion" Text="" Foreground="{StaticResource AccentBrush}" 
                           FontSize="10" Margin="16,0,0,0"/>
                <!-- Mic level bar -->
                <Border Margin="16,0,0,0" Background="#FF0A0A1A" CornerRadius="2" 
                        Width="80" Height="8" VerticalAlignment="Center">
                    <Border x:Name="MicLevelBar" Background="{StaticResource GreenBrush}" 
                            CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                </Border>
                <!-- Connection indicator -->
                <Ellipse x:Name="ConnectionDot" Width="8" Height="8" 
                         Fill="{StaticResource RedBrush}" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content: Video + Chat -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>  <!-- Video -->
                <ColumnDefinition Width="2*" MinWidth="300" MaxWidth="500"/>  <!-- Chat -->
            </Grid.ColumnDefinitions>

            <!-- Left: Video Feed -->
            <Grid Grid.Column="0" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>    <!-- Video -->
                    <RowDefinition Height="Auto"/> <!-- Buttons -->
                </Grid.RowDefinitions>

                <!-- Video display — GPU-accelerated via WriteableBitmap -->
                <Border Grid.Row="0" Background="#FF000000" CornerRadius="6"
                        BorderBrush="#FF333333" BorderThickness="1">
                    <Grid>
                        <Image x:Name="VideoImage" Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <!-- Overlay when camera is off -->
                        <TextBlock x:Name="CameraOffText" Text="Camera Off" 
                                   Foreground="#FF444444" FontSize="24"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- FPS counter -->
                        <TextBlock x:Name="FpsLabel" Text="" Foreground="#FF666666"
                                   FontSize="10" HorizontalAlignment="Right" 
                                   VerticalAlignment="Top" Margin="0,8,8,0"/>
                    </Grid>
                </Border>

                <!-- Control buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="CameraBtn" Content="Start Camera" 
                            Style="{StaticResource MonicaButton}" Click="CameraBtn_Click" Margin="0,0,4,0"/>
                    <Button Content="Show Globe" Style="{StaticResource MonicaButton}" 
                            Click="GlobeBtn_Click" Margin="0,0,4,0"/>
                    <Button Content="Initialize" Style="{StaticResource MonicaButton}" 
                            Click="InitBtn_Click" Margin="0,0,4,0"/>
                    <Button Content="OBS/Spout" Style="{StaticResource MonicaButton}" 
                            Click="SpoutBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- Right: Chat Panel -->
            <Border Grid.Column="1" BorderBrush="#FF333333" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>   <!-- Chat header -->
                        <RowDefinition Height="*"/>    <!-- Messages -->
                        <RowDefinition Height="Auto"/> <!-- Input -->
                    </Grid.RowDefinitions>

                    <!-- Chat header -->
                    <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                            BorderBrush="#FF333333" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                            <TextBlock Text="Chat" Foreground="{StaticResource AccentBrush}" 
                                       FontWeight="SemiBold" FontSize="12"/>
                            <Button x:Name="VoiceBtn" Content="Voice: ON" 
                                    Style="{StaticResource MonicaButton}" 
                                    Click="VoiceBtn_Click" Margin="12,0,0,0"
                                    Padding="8,2" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <!-- Messages list -->
                    <ScrollViewer Grid.Row="1" x:Name="ChatScroll" 
                                  VerticalScrollBarVisibility="Auto" Margin="0">
                        <StackPanel x:Name="ChatMessages" Margin="8"/>
                    </ScrollViewer>

                    <!-- Input area -->
                    <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                            BorderBrush="#FF333333" BorderThickness="0,1,0,0" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChatInput" Grid.Column="0"
                                     Background="#FF0A0A1A" Foreground="{StaticResource TextBrush}"
                                     BorderBrush="#FF444444" BorderThickness="1"
                                     Padding="8,6" FontSize="12" FontFamily="Segoe UI"
                                     KeyDown="ChatInput_KeyDown"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Send" 
                                    Style="{StaticResource MonicaButton}"
                                    Click="SendBtn_Click" Margin="4,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
