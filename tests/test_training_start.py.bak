#!/usr/bin/env python3
"""
Test Training Start - Diagnostic Script
This script tests if training can start without errors.
"""
import sys
from pathlib import Path

print("=" * 80)
print("TRAINING DIAGNOSTIC TEST")
print("=" * 80)
print()

# 1. Check Python version
print(f"[1/7] Python executable: {sys.executable}")
print(f"      Python version: {sys.version.split()[0]}")

# 2. Check PyTorch
try:
    import torch
    print(f"[2/7] PyTorch version: {torch.__version__}")
    print(f"      CUDA available: {torch.cuda.is_available()}")
    if torch.cuda.is_available():
        print(f"      CUDA version: {torch.version.cuda}")
        print(f"      GPU: {torch.cuda.get_device_name(0)}")
except Exception as e:
    print(f"[2/7] PyTorch ERROR: {e}")
    sys.exit(1)

# 3. Check SpeechBrain
try:
    import speechbrain
    print(f"[3/7] SpeechBrain version: {speechbrain.__version__}")
except Exception as e:
    print(f"[3/7] SpeechBrain ERROR: {e}")
    sys.exit(1)

# 4. Check training files exist
project_root = Path(__file__).parent
train_script = project_root / "train_monica.py"
hparams = project_root / "hparams_monica.yaml"

print(f"[4/7] Training script exists: {train_script.exists()} ({train_script})")
print(f"      Hparams file exists: {hparams.exists()} ({hparams})")

if not train_script.exists() or not hparams.exists():
    print("ERROR: Training files not found!")
    sys.exit(1)

# 5. Check manifest file
manifest_file = project_root / "voice_training" / "recordings" / "mjp" / "manifest.json"
print(f"[5/7] Manifest file exists: {manifest_file.exists()} ({manifest_file})")

if manifest_file.exists():
    import json
    try:
        with open(manifest_file, 'r', encoding='utf-8') as f:
            manifest = json.load(f)
        print(f"      Manifest entries: {len(manifest)}")
    except Exception as e:
        print(f"      Manifest ERROR: {e}")

# 6. Check model directory
model_dir = project_root / "models" / "monica_finetuned" / "1986"
print(f"[6/7] Model directory exists: {model_dir.exists()} ({model_dir})")

if model_dir.exists():
    checkpoints = list(model_dir.glob("save/CKPT*"))
    print(f"      Checkpoints found: {len(checkpoints)}")
    if checkpoints:
        latest = sorted(checkpoints)[-1]
        print(f"      Latest checkpoint: {latest.name}")

# 7. Try importing the training script
print(f"[7/7] Testing training script import...")
try:
    # Add to path and try importing
    sys.path.insert(0, str(project_root))

    # Just check if we can read it
    with open(train_script, 'r', encoding='utf-8') as f:
        content = f.read()

    if 'ASRBrain' in content:
        print("      Training script contains ASRBrain class ")

    print("      Training script readable ")

except Exception as e:
    print(f"      Training script ERROR: {e}")
    import traceback
    traceback.print_exc()
    sys.exit(1)

print()
print("=" * 80)
print("DIAGNOSTIC COMPLETE - All checks passed!")
print("=" * 80)
print()
print("Next step: Try running actual training with:")
print(f'  {sys.executable} train_monica.py hparams_monica.yaml')
print()
